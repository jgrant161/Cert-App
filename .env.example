# Settings for running Certificate Review on a server. Copy to .env (never commit .env).

# --- Required in production ---------------------------------------------
CERTAPP_ENV=production
# Long random value that signs sign-in cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CERTAPP_SECRET_KEY=
# Public address of the app, used for Microsoft sign-in and invitation links.
CERTAPP_BASE_URL=https://certs.yourfirm.com
# PostgreSQL connection (Azure Database for PostgreSQL). Keep sslmode=require.
DATABASE_URL=postgresql://certapp:PASSWORD@yourserver.postgres.database.azure.com:5432/certapp?sslmode=require
# Folder for uploaded PDFs. Point it at persistent storage (an Azure Files mount).
CERTAPP_FILES_DIR=/mnt/certfiles
# One-time code required on the first-run setup page. Remove after setup.
CERTAPP_SETUP_TOKEN=

# --- AI reading -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Microsoft 365 sign-in for firm staff (Entra app registration) ---------
CERTAPP_MS_TENANT_ID=
CERTAPP_MS_CLIENT_ID=
CERTAPP_MS_CLIENT_SECRET=
